{
  "actorSpecification": 1,
  "name": "google-shopping-serp",
  "title": "Google Search & Shopping Scraper (CrawlerData)",
  "description": "Google Search results with AI Overview, News, Images, Local, Autocomplete and Google Shopping products and sellers as clean JSON. Bring your CrawlerData API key; no proxies or browsers to manage.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Results",
          "transformation": {
            "fields": [
              "input",
              "endpoint",
              "country",
              "status",
              "credits",
              "error",
              "result"
            ]
          },
          "display": {
            "component": "table"
          }
        }
      }
    }
  },
  "output": "./output_schema.json"
}